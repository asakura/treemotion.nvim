{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump tag-pinned pkgs.fetchFromGitHub sources in flake.nix",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "owner\\s*=\\s*\"(?<owner>[^\"]+)\";\\s*repo\\s*=\\s*\"(?<repo>[^\"]+)\";\\s*rev\\s*=\\s*\"(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "{{{owner}}}/{{{repo}}}",
      "packageNameTemplate": "{{{owner}}}/{{{repo}}}"
    },
    {
      "customType": "regex",
      "description": "Bump commit-pinned pkgs.fetchFromGitHub sources in flake.nix (no tagged releases)",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "owner\\s*=\\s*\"(?<owner>[^\"]+)\";\\s*repo\\s*=\\s*\"(?<repo>[^\"]+)\";\\s*rev\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\";"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "{{{owner}}}/{{{repo}}}",
      "packageNameTemplate": "https://github.com/{{{owner}}}/{{{repo}}}"
    }
  ]
}
